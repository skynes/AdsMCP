.env
.env.*
!.env.example
*.env
*.token
*.session
*.session-journal
*.session-shm
*.session-wal
cookies*.json
*storage-state*.json
secrets/
*.pem
*.p8
*.key
service-account*.json
google-ads.yaml
*.p12
*.pfx
client_secret*.json
credentials*.json
mcp.local.json
.npmrc
*.har
/.local/

# --- Relay server (separate repository, nested .git) ---
server/

# --- Provider MCP modules ---
# modules/modules.example.json (and modules/README.md) stay tracked;
# the local manifest and every module checkout are ignored.
modules/modules.json
modules/*/

# --- Legacy root-level provider installs, venvs and browser profiles ---
.venv*/
venv/
env/
.telegram-ads-*/
.google-ads-mcp*/
.yandex-mcp-*/

# --- Python ---
__pycache__/
*.py[cod]

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

