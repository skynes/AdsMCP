    },
    {
      "id": "reddit_ads",
      "provider": "reddit_ads",
      "label": "Reddit Ads MCP",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "reddit-ads-mcp"],
      "env": {
        "REDDIT_CLIENT_ID": "${REDDIT_CLIENT_ID}",
        "REDDIT_CLIENT_SECRET": "${REDDIT_CLIENT_SECRET}",
        "REDDIT_REFRESH_TOKEN": "${REDDIT_REFRESH_TOKEN}",
        "REDDIT_USER_AGENT": "${REDDIT_USER_AGENT}"
