        "geo_lookup",
        "apps_get",
        "apps_locale_details",
        "apps_eligibilities_find",
        "apps_assets_find",
        "countries_or_regions_list",
        "cpp_list",
        "cpp_get",
        "cpp_locale_details",
        "campaigns_get",
        "campaigns_list",
        "campaigns_find",
