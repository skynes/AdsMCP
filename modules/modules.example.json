{
  "modules": [
    {
      "id": "google_ads_official",
      "provider": "google_ads",
      "label": "Google Ads MCP (official, read-only)",
      "source_url": "https://github.com/googleads/google-ads-mcp",
      "decision_ref": "docs/decisions/0006-google-ads-hub-mcp.md",
      "reviewed_at": "2026-10-08",
      "transport": "stdio",
      "command": "python",
      "cwd": "modules/google-ads-official",
      "args": ["-m", "ads_mcp.server"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${ADS_GOOGLE_ADS_JSON_KEY_FILE_PATH}",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${ADS_GOOGLE_ADS_DEVELOPER_TOKEN}",
        "GOOGLE_PROJECT_ID": "${ADS_GOOGLE_PROJECT_ID}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${ADS_GOOGLE_ADS_LOGIN_CUSTOMER_ID}"
      },
      "allow_tools": [
        "customers_list_accessible_customers",
        "search_search",
        "metadata_get_resource_metadata"
      ],
      "capabilities": ["customers.read", "reports.read", "metadata.read"],
      "notes": "Pinned official googleads/google-ads-mcp v0.0.4 checkout. The server exposes read-only Google Ads tools; OAuth HTTP variables are intentionally not passed, and ads_google_ads_sync remains the normalized SQLite path."
    },
    {
      "id": "google_ads_api_agent",
      "provider": "google_ads",
      "label": "Google Ads API Agent (guarded action adapter)",
      "source_url": "https://github.com/itallstartedwithaidea/google-ads-api-agent",
      "source_ref": "ae56150",
      "decision_ref": "docs/decisions/0008-google-ads-api-agent.md",
      "reviewed_at": "2026-10-08",
      "transport": "stdio",
      "command": "python",
      "cwd": ".",
      "args": ["scripts/google-ads-api-agent-mcp.py"],
      "env": {
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${ADS_GOOGLE_ADS_DEVELOPER_TOKEN}",
        "GOOGLE_ADS_CLIENT_ID": "${ADS_GOOGLE_ADS_CLIENT_ID}",
        "GOOGLE_ADS_CLIENT_SECRET": "${ADS_GOOGLE_ADS_CLIENT_SECRET}",
        "GOOGLE_ADS_REFRESH_TOKEN": "${ADS_GOOGLE_ADS_REFRESH_TOKEN}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${ADS_GOOGLE_ADS_LOGIN_CUSTOMER_ID}",
        "ADS_GOOGLE_ADS_AGENT_ROOT": "${ADS_GOOGLE_ADS_AGENT_ROOT}"
      },
      "allow_tools": ["google_ads_agent_catalog", "google_ads_agent_call"],
      "capabilities": ["accounts.read", "campaigns.read", "reports.read", "keywords.read"],
      "notes": "Runs the pinned google-ads-api-agent checkout through scripts/google-ads-api-agent-mcp.py. Only the adapter catalog and guarded call surface are exposed; provider mutations require confirm=true after explicit user approval."
    },
    {
      "id": "yandex_direct",
      "provider": "yandex_direct",
      "label": "Yandex Direct MCP",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-yandex-direct@latest"],
      "env": {
        "YANDEX_DIRECT_TOKEN": "${YANDEX_DIRECT_TOKEN}"
      },
      "allow_tools": [
        "auth_status",
        "start_login",
        "finish_login",
        "get_account_info",
        "get_balance",
        "get_quota",
        "get_regions",
        "get_dictionaries",
        "list_campaigns",
        "list_ad_groups",
        "list_ads",
        "list_keywords",
        "get_bid_modifiers",
        "get_sitelinks",
        "get_callouts",
        "get_vcards",
        "get_ad_images",
        "get_ad_videos",
        "get_creatives",
        "get_statistics"
      ],
      "capabilities": ["campaigns.read", "reports.read", "reports.statistics"],
      "notes": "The template is read-only by default. Add explicit write tools to allow_tools only after guardrails are ready."
    },
    {
      "id": "yandex_mcp_zai",
      "provider": "yandex_direct",
      "label": "ZAI Yandex MCP: Direct + Metrika + Webmaster (guarded Direct writes)",
      "source_url": "https://github.com/zai-one/yandex-mcp",
      "decision_ref": "docs/decisions/0007-yandex-direct-zai-module.md",
      "reviewed_at": "2026-10-08",
      "transport": "stdio",
      "command": "python",
      "cwd": ".",
      "args": [
        "scripts/yandex-direct-mcp.py"
      ],
      "allow_tools": [
        "direct_list_campaigns",
        "direct_get_campaign",
        "direct_get_inventory",
        "direct_get_statistics",
        "direct_keyword_forecast",
        "direct_write",
        "metrika_list_counters",
        "metrika_list_goals",
        "metrika_get_statistics",
        "metrika_report",
        "webmaster_get_user",
        "webmaster_list_hosts",
        "webmaster_get_host",
        "webmaster_get_verification",
        "webmaster_get_summary",
        "webmaster_get_diagnostics",
        "webmaster_get_query_history",
        "webmaster_list_popular_queries",
        "webmaster_get_indexing_history",
        "webmaster_list_indexing_samples",
        "webmaster_list_search_urls",
        "webmaster_get_search_urls_history",
        "webmaster_list_sitemaps",
        "webmaster_get_sitemap",
        "webmaster_list_user_sitemaps",
        "webmaster_list_external_links",
        "webmaster_get_external_links_history",
        "webmaster_list_broken_links",
        "webmaster_get_broken_links_history",
        "webmaster_list_recrawl_queue",
        "webmaster_get_recrawl_quota",
        "webmaster_get_recrawl_task"
      ],
      "capabilities": [
        "campaigns.read",
        "campaigns.write",
        "stats.read",
        "metrika.read",
        "webmaster.read"
      ],
      "notes": "ZAI.ONE yandex-mcp v0.3.0 from modules/yandex-direct, started over stdio by scripts/yandex-direct-mcp.py with the isolated modules/yandex-direct-deps tree. The launcher maps ADS_YANDEX_* settings from the ignored AdsMCP .env; ADS_YANDEX_DIRECT_WRITE_ENABLED controls the provider Direct write runtime, while Metrika, Webmaster and paid Wordstat writes stay off. The raw direct_write tool is allowlisted only for the internal guarded ads_yandex_direct_write path, which requires confirm=true, idempotency_key and provider readback."
    },
    {
      "id": "telegram_ads",
      "provider": "telegram_ads",
      "label": "Telegram Ads MCP (HTTP session)",
      "source_url": "https://github.com/zai-one/telegram-ads-mcp",
      "decision_ref": "docs/decisions/0001-telegram-ads-module.md",
      "reviewed_at": "2026-10-08",
      "transport": "streamable_http",
      "url": "http://127.0.0.1:8766/mcp",
      "allow_tools": [
        "check_session",
        "list_accounts",
        "select_account",
        "get_account",
        "get_ads",
        "get_ad",
        "get_ad_stats",
        "search_targets",
        "get_targeting_reference",
        "check_ad_post"
      ],
      "capabilities": ["accounts.read", "accounts.context_switch", "ads.read", "stats.read", "targeting.read"],
      "notes": "ZAI module uses one local Streamable HTTP process and the logged-in ads.telegram.org HTTP session; it does not start Chromium. Start scripts/start-telegram-ads-mcp.ps1 once; it loads the session from ADS_MCP_DATA/secrets/telegram-ads-session.env. Strict mode and the dedicated AdsMCP account workflow keep provider writes disabled."
    },
    {
      "id": "vk_ads_clickru_broker",
      "provider": "vk_ads",
      "label": "Click.ru VK Ads MCP broker (read-only)",
      "source_url": "https://help.click.ru/7938",
      "reviewed_at": "2026-10-08",
      "transport": "streamable_http",
      "url": "https://vkads-mcp.aihub.click.ru/c/${ADS_CLICKRU_API_TOKEN}/${ADS_CLICKRU_VK_ACCOUNT_ID}",
      "allow_tools": [
        "vk_ads_auth_check",
        "vk_ads_account_info",
        "vk_ads_accounts_list",
        "vk_ads_ad_plans_list",
        "vk_ads_ad_plans_get",
        "vk_ads_campaigns_list",
        "vk_ads_campaigns_get",
        "vk_ads_ad_groups_list",
        "vk_ads_ad_groups_get"
      ],
      "capabilities": ["accounts.read", "campaigns.read", "reports.read"],
      "notes": "The URL placeholder ADS_CLICKRU_API_TOKEN is resolved from local clickru-settings.json by AdsMCP. The broker obtains/refreshes VK access through Click.ru; provider write tools stay outside the allowlist until a separate approval gate exists."
    },
    {
      "id": "microsoft_ads_official",
      "provider": "bing_ads",
      "label": "Microsoft Advertising MCP (Bing Ads)",
      "transport": "streamable_http",
      "url": "https://partner.api.bingads.microsoft.com/ext/mcp/vnext?toolSetNames=OpenBeta",
      "token_env": "MICROSOFT_ADS_ACCESS_TOKEN",
      "allow_tools": [
        "get_accounts",
        "get_campaigns",
        "get_ad_groups",
        "get_ads",
        "get_keywords",
        "get_asset_groups",
        "get_audience_associations"
      ],
      "capabilities": ["campaigns.read", "reports.read", "keywords.read"],
      "notes": "Official remote Microsoft Advertising MCP. The local Microsoft profile page handles PKCE OAuth and refreshes tokens locally; writes stay outside the allowlist."
    },
