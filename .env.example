# Single local data root for all AdsMCP modules. Defaults to ./data next to the package.
ADS_MCP_DATA=./data

# Optional GitHub update check. At MCP startup AdsMCP checks at most once per
# 24 hours and downloads a newer GitHub release/tag archive into
# ADS_MCP_DATA/updates without overwriting the running installation.
# The repository is also detected from the local git origin when available.
# ADSMCP_UPDATE_ENABLED=true
# ADSMCP_UPDATE_REPOSITORY=owner/repository
# ADSMCP_GITHUB_TOKEN is shared by update checks and the optional contribution workflow.
# ADSMCP_UPDATE_DEBUG=false

# GitHub contribution setup. A fork is optional for local use, but required before
# AdsMCP can publish a branch and PR. The setup tool can create the fork after
# the user confirms; the token is read only from this environment variable.
# A fine-grained token needs Contents: Read and write and Pull requests: Read and write.
# ADSMCP_UPSTREAM_REPOSITORY=skynes/AdsMCP
# ADSMCP_FORK_REPOSITORY=your-github-user/AdsMCP
# ADSMCP_GITHUB_TOKEN=

# Weekly contribution check. It detects any local source, documentation or module
# changes. Recommendation-only changes can be submitted automatically; broader
# project changes are reported for review and require ads_github_contribution_create_pr
# with confirm=true. Set false to disable the weekly check entirely.
# ADSMCP_WEEKLY_PR_ENABLED=true
# ADSMCP_RECOMMENDATIONS_DIR=docs/recommendations
# ADSMCP_CONTRIBUTION_BASE_BRANCH=main
# Optional provider MCP module manifest. Copy modules/modules.example.json to modules/modules.json
# and keep credentials in environment variables, not in the manifest.
# ADS_MCP_MODULES_FILE=./modules/modules.json

# Optional Ads Network Relay. The local MCP works without it.
# ADS_NETWORK_URL=http://127.0.0.1:8787
# ADS_NETWORK_WRITE_TOKEN=

# dStore public catalog adapter. Card JSON and verified advertising placements are read-only.
# ADS_DSTORE_BASE_URL=https://dstore.one
# ADS_DSTORE_CATALOG_URL=https://db.dstore.one
# ADS_DSTORE_TIMEOUT_MS=10000

# AIKI community source. The agent key is configured in the AIKI MCP client,
# never in AdsMCP or SQLite. AIKI proposals stay unverified until dStore checks them.
# ADS_AIKI_NODE_URL=https://aiki.wiki
# ADS_AIKI_TOPIC_SLUG=adsmcp
# ADS_AIKI_SYNC_INTERVAL_HOURS=24

# Integration credentials stay in environment variables, never in SQLite.
# ADS_GOOGLE_ADS_CUSTOMER_ID=1234567890
# ADS_GOOGLE_ADS_LOGIN_CUSTOMER_ID=9876543210
# ADS_GOOGLE_ADS_DEVELOPER_TOKEN=
# ADS_GOOGLE_ADS_JSON_KEY_FILE_PATH=./data/secrets/google-ads-service-account.json
# ADS_GOOGLE_ADS_API_VERSION=v22
# ADS_GOOGLE_PROJECT_ID=
# Google Ads API Agent adapter (OAuth refresh-token credentials; separate from the service-account fallback above)
# ADS_GOOGLE_ADS_CLIENT_ID=
# ADS_GOOGLE_ADS_CLIENT_SECRET=
# ADS_GOOGLE_ADS_REFRESH_TOKEN=
# ADS_GOOGLE_ADS_AGENT_ROOT=./modules/google-ads-api-agent
# Mutations require confirm=true in google_ads_agent_call after explicit user approval.
# Google Ads MCP by Advertising Hub (google-ads.yaml or OAuth credentials)
# GOOGLE_ADS_CREDENTIALS=./data/secrets/google-ads.yaml
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# Click.ru VK Ads broker (vk_ads_clickru_broker): VK Ads account id used in the module URL.
# ADS_CLICKRU_VK_ACCOUNT_ID=123456
# YANDEX_DIRECT_TOKEN=
# ZAI Yandex MCP (modules/yandex-direct; stdio via scripts/yandex-direct-mcp.py).
# Paths to private OAuth token files (relative to the project root or absolute), never token values.
# ADS_YANDEX_DIRECT_TOKEN_FILE=data/secrets/yandex-direct.token
# ADS_YANDEX_DIRECT_CLIENT_LOGIN=
# Direct writes are disabled by default. Enable only together with the guarded
# ads_yandex_direct_write tool, which requires confirm=true and idempotency_key.
# ADS_YANDEX_DIRECT_WRITE_ENABLED=false
# ADS_YANDEX_METRIKA_TOKEN_FILE=data/secrets/yandex-metrika.token
# ADS_YANDEX_WEBMASTER_TOKEN_FILE=data/secrets/yandex-webmaster.token
# ADS_YANDEX_ACCOUNT_ID=default
# ADS_YANDEX_MCP_DIR=modules/yandex-direct
# ADS_TELEGRAM_BOT_TOKEN=
# Telegram Ads MCP (ZAI HTTP module; no separate Chromium runtime)
# ADS_TELEGRAM_MCP_DIR=./modules/telegram-ads
# Official Telegram Ads API (read/report layer; create a token in Telegram Ads account settings)
# ADS_TELEGRAM_ADS_API_TOKEN=
# ADS_TELEGRAM_ADS_API_BASE_URL=https://promoteapi.telegram.org
# Local Telegram user account for the Alice outreach workflow (GramJS by default).
# Create an app at https://my.telegram.org/apps; never commit these values.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# Optional aliases copied from the Workix integration:
# TG_APP_API_ID=
# TG_APP_API_HASH=
# GramJS uses the local gramjs.session and works on Windows ARM64. TDLib remains optional.
# TELEGRAM_ACCOUNT_BACKEND=gramjs
# TELEGRAM_TDLIB_VERBOSITY=1
# Discord community connector: official bot token only; never use a normal user token/password.
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_API_BASE_URL=https://discord.com/api/v10
# Mastodon account connector. OAuth connection through ads_mastodon_auth_start does not
# require these values; they are an optional environment-token fallback for one account.
# MASTODON_INSTANCE_URL=https://mastodon.social
# MASTODON_ACCESS_TOKEN=
# MASTODON_ACCOUNT_ID=env_default
# read:follows is mandatory so the connector can check existing subscriptions
# before following discovery candidates.
# MASTODON_SCOPES=read:accounts read:follows read:notifications read:statuses write:follows write:statuses write:accounts
# MASTODON_CLIENT_NAME=AdsMCP
# Optional per-account override; account id neron_one becomes MASTODON_CLIENT_NAME_NERON_ONE.
# MASTODON_CLIENT_NAME_NERON_ONE=neron.one
# MASTODON_APP_WEBSITE=
# Optional puppeteer-core install reused by `npm run telegram:login` (package.json of a project
# that has puppeteer-core); defaults to normal Node resolution from this project.
# ADS_PUPPETEER_PACKAGE_JSON=<path-to>/project-with-puppeteer/package.json
# Microsoft Advertising / Bing Ads MCP
# MICROSOFT_ADS_ACCESS_TOKEN=
# BING_ADS_DEVELOPER_TOKEN=
# BING_ADS_CUSTOMER_ID=
# BING_ADS_ACCOUNT_ID=

# Avito Ads MCP (official Avito Ads API, read-only module allowlist)
# Create Client Key and Client Secret in the Avito Ads account settings.
# AVITO_ADS_CLIENT_ID=
# AVITO_ADS_CLIENT_SECRET=
# AVITO_ADS_ACCOUNT_ID=
# AVITO_ADS_ENVIRONMENT=production
# AVITO_ADS_TIMEOUT_MS=30000
# AVITO_ADS_MAX_RETRIES=4
# AVITO_ADS_TOKEN_LEEWAY_SECONDS=60
# Apple Search Ads MCP
# ASA_CLIENT_ID=
# ASA_TEAM_ID=
# ASA_KEY_ID=
# ASA_PRIVATE_KEY_PATH=./data/secrets/apple-search-ads-private-key.p8
# ASA_ORG_ID=
# Meta Ads MCP (local read-only wrapper for the official Meta Graph API)
# META_ACCESS_TOKEN=
# META_ENABLE_WRITES=0
# META_API_VERSION=v26.0
# Apple Search Ads MCP (Apple Ads Platform API v1, local read-only)
# APPLE_ADS_PROFILE=production-read-only
# APPLE_ADS_CLIENT_ID=
# APPLE_ADS_TEAM_ID=
# APPLE_ADS_KEY_ID=
# APPLE_ADS_PRIVATE_KEY_PATH=./data/secrets/apple-ads-private-key.pem
# APPLE_ADS_AD_ACCOUNT_ID=
# APPLE_ADS_ALLOW_WRITES=false
# APPLE_ADS_ALLOW_DELETES=false
# TikTok Ads MCP
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# X Ads MCP (local read-only wrapper for the official X Ads API)
# X_ADS_ACCESS_TOKEN=
# X_ADS_ACCOUNT_IDS=
# X_ADS_SCOPES=ads.read
# X_ADS_ENABLE_WRITES=false
# Spotify Ads MCP (local Adport, direct official Spotify Ads API)
# ADPORT_HOME=
# TikTok Ads MCP (local read-only wrapper for the TikTok Business API)
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_ADVERTISER_ID=
# TIKTOK_BC_ID=
# TIKTOK_ENABLE_WRITES=0
# OpenAI Ads / ChatGPT Ads Advertiser API (official, local read-only bridge)
# OPENAI_ADS_API_KEY=
# OPENAI_ADS_BASE_URL=https://api.ads.openai.com/v1
# LOG_LEVEL=info
# Reddit Ads MCP
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_REFRESH_TOKEN=
# REDDIT_ADS_ACCOUNT_ID=
# REDDIT_ADS_WRITE_TIER=read
# REDDIT_USER_AGENT=ads-mcp/1.1.1
# Email MCP (IMAP checks + SMTP sending; use an app password where the provider supports it)
# MCP_EMAIL_ADDRESS=
# MCP_EMAIL_PASSWORD=
# MCP_EMAIL_IMAP_HOST=
# MCP_EMAIL_SMTP_HOST=
# MCP_EMAIL_ACCOUNT_NAME=default
# MCP_EMAIL_FULL_NAME=
# MCP_EMAIL_USERNAME=
# MCP_EMAIL_IMAP_PORT=993
# MCP_EMAIL_IMAP_TLS=true
# MCP_EMAIL_SMTP_PORT=465
# MCP_EMAIL_SMTP_TLS=true
# MCP_EMAIL_SMTP_STARTTLS=false
# MCP_EMAIL_SMTP_VERIFY_SSL=true
# MCP_EMAIL_RATE_LIMIT=10
# MCP_EMAIL_SEND_SAVE_TO_SENT=false
# MCP_EMAIL_READ_ONLY=false
# Optional multi-account JSON override supported by @codefuturist/email-mcp.
# EMAIL_ACCOUNTS=
# ADS_CRM_BASE_URL=
# ADS_CRM_API_TOKEN=

# Relay server settings when running `npm run dev:server` or `npm run start:server`.
# ADS_NETWORK_HOST=127.0.0.1
# ADS_NETWORK_PORT=8787
# Relay state always uses the shared ADS_MCP_DATA/network directory.
# ADS_NETWORK_BASE_PATH=/api
# ADS_NETWORK_WRITE_TOKEN=
